################################################################################
# MariaDB tuning for Adobe Commerce (development)
#
# The stack now runs MariaDB (10.6 for the 2.4.7 baseline, 11.4 for the 2.4.9
# target) to mirror the project's Adobe Commerce Cloud database. Every directive
# here is valid on BOTH 10.6 and 11.4 — deliberately NO MySQL-8-only options
# (innodb_redo_log_capacity, log_error_verbosity, authentication_policy), which
# MariaDB rejects with "unknown variable" and aborts on startup.
#
# Sized for a 16GB workstation running one profile at a time.
################################################################################

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

max_connections = 150

# Large dumps fail on the 64M default mid-import; 256M covers a Magento export.
max_allowed_packet = 256M

innodb_buffer_pool_size = 1G

# MariaDB uses innodb_log_file_size (MySQL 8's innodb_redo_log_capacity does not
# exist here and would abort startup).
innodb_log_file_size = 512M

# =2 trades crash durability for a large write speedup. Fine for a dev box
# (worst case ~1s of writes lost on a hard kill); never use in production.
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_stats_on_metadata = 0

tmp_table_size = 128M
max_heap_table_size = 128M
table_open_cache = 4000
sort_buffer_size = 4M
join_buffer_size = 4M

# Magento's installer and some modules emit queries that trip ONLY_FULL_GROUP_BY;
# relaxing sql_mode avoids setup:upgrade failures.
sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

# MariaDB equivalent of MySQL's log_error_verbosity.
log_warnings = 2
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

skip_name_resolve = 1
explicit_defaults_for_timestamp = 1

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
