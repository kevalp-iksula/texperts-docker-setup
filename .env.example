################################################################################
# Adobe Commerce 2.4.9 Development Stack - environment template
#
# Copy to .env and edit:  cp .env.example .env   (or run ./init-project.sh)
#
# .env is gitignored and holds real passwords. .env.example is committed and
# must never contain a real secret.
################################################################################

################################################################################
# Project paths
################################################################################

# Where the Magento source lives on the host. Bind-mounted into the container
# at /var/www/magento, which is what makes live code reload work.
# Default keeps the code inside this project; point it elsewhere if you prefer.
PROJECT_PATH=./volumes/code

# Composer credentials for repo.magento.com. Generate with ./scripts/composer-auth.sh
# Mounted read-only into the container; never baked into an image.
COMPOSER_AUTH_FILE=./scripts/.composer-auth.json

################################################################################
# Version profile  -->  DEFAULT: 2.4.7 baseline (install this FIRST)
#
# A 2.4.7 codebase must be installed on the 2.4.7 runtime (its composer.lock
# pins PHP ~8.1/8.2/8.3). You reach 2.4.9 by running the UPGRADE (composer
# update) on the 2.4.9 profile — not by `composer install`. So a fresh setup
# defaults to 2.4.7; switch with `make profile-249` when you do the upgrade.
#
#   make profile-247   -> PHP 8.3 / MariaDB 10.6 / OpenSearch 2   (these values)
#   make profile-249   -> PHP 8.5 / MariaDB 11.4 / OpenSearch 3
################################################################################

PHP_DOCKERFILE=8.3/Dockerfile
PHP_TAG=8.3
DB_IMAGE=mariadb:10.6

################################################################################
# Host ports
# Check availability before starting:  make ports
################################################################################

NGINX_PORT=8080
MYSQL_PORT=3307
OPENSEARCH_PORT=9201
VALKEY_PORT=6380

################################################################################
# Database
#
# CHANGE BOTH PASSWORDS. docker-compose.yml refuses to start if either is unset.
################################################################################

MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=CHANGE_ME_magento

################################################################################
# Search - baseline 2.4.7 uses OpenSearch 2; the 2.4.9 target requires OpenSearch 3.x
################################################################################

OPENSEARCH_VERSION=2
# Heap. Total container use lands near 2x this. 1g suits a 16GB box; drop to
# 512m if memory is tight, raise to 2g for a large catalog.
OPENSEARCH_HEAP_SIZE=1g

################################################################################
# Cache / sessions
################################################################################

VALKEY_MAXMEMORY=512mb

################################################################################
# PHP  (version set by the Version profile above: 8.3 baseline / 8.5 target)
################################################################################

PHP_MEMORY_LIMIT=2G
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_DISPLAY_ERRORS=1

# 1 = OPcache re-checks file mtimes each request, so edits appear immediately.
# 0 = production-like caching; you must run 'make flush' to see code changes.
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1

################################################################################
# Xdebug - off by default; it costs roughly 2-3x on every request
################################################################################

XDEBUG_ENABLED=0
XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

################################################################################
# Docker
################################################################################

COMPOSE_PROJECT_NAME=ac

# Must not collide with an existing Docker network. Check: docker network ls
NETWORK_SUBNET=172.29.0.0/24

# File ownership mapping. init-project.sh fills these with your real uid/gid so
# files written inside the container stay editable on the host.
UID=1000
GID=1000

TZ=UTC

LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

################################################################################
# Phase 3 - Magento install / import (not used until then)
################################################################################

MAGENTO_VERSION=2.4.7

# Which edition `make magento-install` downloads:
#   community  = Magento Open Source (free; keys just need to exist)
#   enterprise = Adobe Commerce (needs a paid license entitlement on your keys)
# To switch later: make magento-uninstall, change this, make magento-install.
MAGENTO_EDITION=community

BASE_URL=http://localhost:8080/

ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_USER=admin
# Magento requires a mix of letters and numbers, 7+ chars.
ADMIN_PASSWORD=CHANGE_ME_Admin123

# Path to a dump for ./scripts/restore-db.sh (leave blank for a fresh install)
DB_IMPORT_FILE=
